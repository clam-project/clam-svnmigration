prefer git

# SVN revision as git trailer
=C append "\nSVN-Revision: %LEGACY%" --legacy
=C filter replace /SVN-Revision: SVN:/SVN-Revision: /c

# Delete unlabeled-[cvs-branch], they are broken leftovers of deleted cvs branches (see notes.md)
branch delete /unlabeled-/

# Empty commit tags: append SVN-Revision trailer and delete tag
script generated/emptycommits.lift

